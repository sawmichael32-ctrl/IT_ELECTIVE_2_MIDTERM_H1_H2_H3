@model IT_ELECTIVE_2_MIDTERM_H1_H2_H3.Models.DTOs.CheckoutFormDTO

@{
    ViewData["Title"] = "Checkout";
}

<h2>Checkout</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<form asp-action="Index" method="post">

    <div class="mb-3">
        <label asp-for="CustomerName" class="form-label"></label>
        <input asp-for="CustomerName" class="form-control" />
        <span asp-validation-for="CustomerName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CustomerEmail" class="form-label"></label>
        <input asp-for="CustomerEmail" class="form-control" />
        <span asp-validation-for="CustomerEmail" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Complete Checkout
    </button>

    <a asp-controller="Cart" asp-action="Index" class="btn btn-secondary">
        Back to Cart
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}