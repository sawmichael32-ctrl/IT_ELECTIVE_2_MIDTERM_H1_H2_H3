@model IT_ELECTIVE_2_MIDTERM_H1_H2_H3.Models.Entities.ShoppingCart

@{
    ViewData["Title"] = "Shopping Cart";
}

<h2>Shopping Cart</h2>

<a asp-controller="Products"
   asp-action="Index"
   class="btn btn-secondary mb-3">
    Continue Shopping
</a>

<table class="table table-bordered">

    <thead>

        <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
            <th>Update</th>
            <th>Remove</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model.Items)
        {
            <tr>

                <form asp-action="Update" method="post">

                    <input type="hidden"
                           name="ProductId"
                           value="@item.ProductId" />

                <td>@item.ProductName</td>

                <td>₱@item.UnitPrice</td>

                <td>

                    <input type="number"
                           name="Quantity"
                           value="@item.Quantity"
                           min="1"
                           class="form-control" />

                </td>

                <td>₱@item.LineTotal</td>

                <td>

                    <button class="btn btn-warning">
                        Update
                    </button>

                </td>

                </form>

                <td>

                    <form asp-action="Remove" method="post">

                        <input type="hidden"
                               name="productId"
                               value="@item.ProductId" />

                        <button class="btn btn-danger">
                            Remove
                        </button>

                    </form>

                </td>

            </tr>
        }

    </tbody>

</table>

<h3 class="text-end">
    Grand Total: ₱@Model.GrandTotal
</h3>

<a asp-controller="Checkout"
   asp-action="Index"
   class="btn btn-success">
    Proceed to Checkout
</a>